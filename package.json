{
  "name": "movie-website",
  "version": "1.0.0",
  "private": true,
  "main": "backend/server.js",
  "scripts": {
    "start": "npx http-server public -p 5050 -c-1",
    "dev": "npx http-server public -p 5050 -c-1",
    "build:react": "esbuild public/js/react/index.jsx --bundle --outfile=public/js/mood-scanner.bundle.js --loader:.js=jsx --target=es2020",
