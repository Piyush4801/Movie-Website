  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "framer-motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
